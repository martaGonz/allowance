# The Graph — https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=
# Standardized Subgraph de Messari para Uniswap v3 en Base (esquema DEX AMM Extended)
GRAPH_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/FUbEPQw1oMghy39fwWBFY5fE6MXPXZQtjncQy2cXdrNS

# Puerta x402 sobre Hedera testnet — cuenta del agente que paga, del payer en EVM,
# de la puerta que cobra, del facilitador Blocky402 y URL de la puerta
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_EVM_ADDRESS=
GATE_PAYTO_ACCOUNT_ID=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
GATE_URL=http://localhost:8402

# Tesorería en Arc testnet — Developer-Controlled Wallet de Circle. El fichero de recuperación del entity secret va en .circle/, nunca aquí.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
# El "float owner": la cuenta que adelantó su propio USDC para pagar la puerta x402 en Hedera
# y que la tesorería reembolsa en Arc por cada pago liquidado ("Two rails, one payment" — ver
# README y docs/architecture.md). No es un segundo comprador, es a quién se reembolsa el float.
ARC_OPERATOR_ADDRESS=
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network

# Analista — API de Anthropic, https://console.anthropic.com/settings/keys.
# new Anthropic() la resuelve sola; el agente sigue gastando/parándose igual si falta,
# el analista solo deja de opinar (analysis_failed en cada ronda).
ANTHROPIC_API_KEY=

# Punto de entrada del agente (src/agent/main.ts) — paga emitida y posición vigilada.
# WATCH_TOKEN_CONTRACT por defecto es WETH en Base si se deja vacío.
# 30_000 microUSDC (0.03 USDC), no 5_000_000: con los precios del catálogo (2_000 / 12_000
# microUSDC) la paga se agota en pocas rondas en vez de ~19 horas — la demo necesita alcanzar
# el agotamiento en cámara (ver docs/demo-script.md, checklist de pregrabación).
ALLOWANCE_AMOUNT_MICRO_USDC=30000
ALLOWANCE_TTL_MS=3600000
WATCH_POSITION_ID=
WATCH_TOKEN_CONTRACT=0x4200000000000000000000000000000000000006

# Panel (src/panel/server.ts)
PANEL_PORT=8787

# Asset Tokenization Studio en Hedera testnet — despliegue público
# verificado (hashgraph/asset-tokenization-studio, apps/ats/web/.env.example). Se llama por
# viem sobre el relay JSON-RPC, nunca con el SDK de ATS (sus carteras son navegador/HWC/DFNS/
# Fireblocks/AWS KMS, no clave privada de servidor). Si ATS_ISSUER_PRIVATE_KEY o
# HEDERA_EVM_ADDRESS faltan, main.ts emite la nota solo en memoria y sigue sin tocar cadena.
ATS_ISSUER_PRIVATE_KEY=
ATS_FACTORY_ID=0.0.9213391
ATS_RESOLVER_ID=0.0.9212226
HEDERA_RPC_RELAY=https://testnet.hashio.io/api
